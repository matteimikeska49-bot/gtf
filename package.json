{
  "name": "gotoflow",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "prerender": "node prerender.mjs",
    "postbuild": "node prerender.mjs && npm run build:marker",
    "check:blog": "npm run build && npm run check:blog:run && npm run check:blog:content-template && npm run check:blog:product-links",
    "check:blog:run": "node scripts/check-blog-publishing.mjs",
    "check:blog:cannibalization": "node scripts/check-blog-cannibalization.mjs",
    "check:blog:seo-meta": "node scripts/check-blog-seo-meta.mjs",
    "check:blog:schema": "node scripts/check-blog-schema.mjs",
    "check:blog:links": "node scripts/check-blog-links.mjs",
    "check:blog:product-links": "node scripts/check-blog-product-links.mjs",
    "check:blog:mockups": "node scripts/check-blog-mockups.mjs",
    "check:blog:batch": "node scripts/check-blog-batch.mjs",
    "check:blog:production": "node scripts/check-blog-production.mjs",
    "check:blog:topics": "node scripts/check-blog-topic-research.mjs",
    "check:blog:keywords": "node scripts/check-blog-keywords.mjs",
    "check:blog:topic-score": "node scripts/check-blog-topic-score.mjs",
    "check:blog:product-claims": "node scripts/check-blog-product-claims.mjs",
    "check:blog:intent-ownership": "node scripts/check-blog-intent-ownership.mjs",
    "check:blog:cluster-map": "node scripts/check-blog-cluster-map.mjs",
    "check:blog:brief-alignment": "node scripts/check-blog-brief-alignment.mjs",
    "check:blog:frontmatter-contract": "node scripts/check-blog-frontmatter-contract.mjs",
    "check:blog:faq-cta-contract": "node scripts/check-blog-faq-cta-contract.mjs",
    "check:blog:product-led-links": "node scripts/check-blog-product-led-links.mjs",
    "check:blog:internal-link-flow": "node scripts/check-blog-internal-link-flow.mjs",
    "check:blog:language-consistency": "node scripts/check-blog-language-consistency.mjs",
    "check:blog:mockup-relevance": "node scripts/check-blog-mockup-relevance.mjs",
    "check:blog:draft-safety": "node scripts/check-blog-draft-safety.mjs",
    "recalculate:topic-scores": "node scripts/recalculate-topic-scores.mjs",
    "import:keyword-demand": "node scripts/import-keyword-demand.mjs",
    "check:blog:dist": "node scripts/check-blog-dist.mjs",
    "check:blog:all": "npm run build && npm run check:blog:dist && npm run check:blog:run && npm run check:blog:content-template && npm run check:blog:product-links && npm run check:blog:seo-meta && npm run check:blog:cannibalization && npm run check:blog:links && npm run check:blog:mockups && npm run check:blog:schema && npm run check:blog:batch && npm run check:blog:topics && npx start-server-and-test preview http-get://localhost:4173 \"npm run check:blog:render:run && npm run check:blog:visual:run\"",
    "check:blog:deploy": "npm run check:blog:all && npm run check:blog:production",
    "check:blog:render": "npm run build && npx start-server-and-test preview http-get://localhost:4173 \"npm run check:blog:render:run\"",
    "check:blog:render:run": "node scripts/check-blog-render.mjs",
    "check:blog:visual": "npm run build && npx start-server-and-test preview http-get://localhost:4173 \"npm run check:blog:visual:run\"",
    "check:blog:visual:run": "node scripts/check-blog-visual.mjs",
    "build:marker": "node scripts/generate-build-info.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "check:blog:content-template": "node scripts/check-blog-content-template.mjs"
  },
  "dependencies": {
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.7.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.14.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "postcss": "^8.5.8",
    "puppeteer": "^24.42.0",
    "tailwindcss": "^3.4.19",
    "vite": "^8.0.1"
  }
