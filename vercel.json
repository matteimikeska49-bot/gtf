{
  "redirects": [
    {
      "source": "/carousel-maker",
      "destination": "/ai-carousel-maker",
      "permanent": true
    },
    {
      "source": "/ru/ii-generator-kontenta",
      "destination": "/ru/generator-kontenta",
      "permanent": true
    },
    {
      "source": "/ru/ii-generator-postov-dlya-instagram",
      "destination": "/ru/generator-postov-instagram",
      "permanent": true
    },
    {
      "source": "/ru/ii-generator-postov-dlya-linkedin",
      "destination": "/ru/generator-karuselej-linkedin",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|gif|webp|ico|svg|webmanifest|mp4)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
